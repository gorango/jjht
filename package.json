{
  "name": "jigjoy",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "modules/mozaik"],
  "scripts": {
    "postinstall": "bun run --filter @mozaik-ai/core build",
    "build:mozaik": "bun run --filter @mozaik-ai/core build",
    "eureka:start": "bun run --filter eureka start",
    "eureka:run": "bun run --filter eureka run",
    "eureka:mock": "bun run --filter eureka mock",
    "eureka:trace": "bun run --filter eureka trace",
    "eureka:openalex": "bun run --filter eureka openalex",
    "eureka:eval": "bun run --filter eureka eval",
    "eureka:audit": "bun run --filter eureka audit",
    "eureka:serve": "bun run --filter eureka serve",
    "eureka:concurrency": "bun run --filter eureka concurrency",
    "eureka:refresh-examples": "bun run --filter eureka refresh:examples",
    "eureka:check-examples": "bun run --filter eureka check:examples",
    "eureka:typecheck": "bun run --filter eureka typecheck",
    "eureka:build": "bun run --filter eureka build",
    "eureka:test": "bun run --filter eureka test",
    "custody": "bun --cwd packages/custody src/index.ts demo",
    "custody:dashboard": "bun --cwd packages/custody src/server.ts",
    "custody:verify-evidence": "bun packages/custody/scripts/verify-evidence.ts",
    "custody:docker:up": "bun run --cwd packages/custody docker:up",
    "custody:docker:down": "bun run --cwd packages/custody docker:down",
    "custody:ablate": "bun --cwd packages/custody scripts/ablate.ts",
    "custody:test": "bun --cwd packages/custody test",
    "custody:typecheck": "bun --cwd packages/custody run typecheck"
  }
}
