{
  "name": "eureka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EUREKA — an evidence-first, concurrent researcher–company matchmaker built on Mozaik",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "bun src/index.ts run",
    "run": "bun src/index.ts run",
    "mock": "MOCK=1 bun src/index.ts run",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "trace": "bun src/index.ts trace",
    "openalex": "bun src/index.ts openalex",
    "test": "bun test tests/critic.test.ts",
    "refresh:calls": "bun scripts/refresh-calls.ts",
    "eval": "bun scripts/eval.ts"
  },
  "dependencies": {
    "@mozaik-ai/core": "workspace:*",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
