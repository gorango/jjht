# baro handoff. Copy to .env and fill the key.
#
# OpenCode Go, OpenAI-compatible endpoint. baro's native runner reaches it
# through scripts/opencode-go-proxy.ts, which adds the required
# x-opencode-session header.
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_GO_API_KEY=

# Model routing. Pro for the work that writes code; Flash for cheap judgment.
BARO_STORY_MODEL=deepseek-v4-pro
BARO_ARCHITECT_MODEL=deepseek-v4-pro
BARO_SURGEON_MODEL=deepseek-v4-pro
BARO_PLANNER_MODEL=deepseek-v4.1-flash
BARO_CRITIC_MODEL=deepseek-v4.1-flash
BARO_DIALOGUE_MODEL=deepseek-v4.1-flash

# Target checkout and goal, relative to packages/custodian.
BARO_SCRATCH_REPO=../../modules/custodian-scratch
BARO_GOAL_FILE=outbox/inc-1/goal.txt

# Run shape.
BARO_EFFORT=high
BARO_TIMEOUT=900
# BARO_BIN=/home/you/.baro/bin/baro
