# --- inference: pick ONE provider -------------------------------------------
#
# Option A — OpenRouter (one key, many models). Takes precedence when set.
#   https://openrouter.ai/keys
#   Model ids are OpenRouter ids: vendor/model  (e.g. deepseek/deepseek-v4-pro)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Option B — a single provider, using Mozaik's bundled model names.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# DeepSeek / OpenRouter / vLLM / Ollama through the OpenAI-compatible endpoint:
OPENAI_BASE_URL=

# Model routing. Strong = matchmaker + writer; fast = profiler, analyst, critic.
# With OpenRouter, use OpenRouter ids. Without it, use bundled names.
EUREKA_MODEL=deepseek/deepseek-v4-pro
EUREKA_FAST_MODEL=deepseek/deepseek-v4.1-flash

# Run the whole pipeline offline with a deterministic stand-in model.
MOCK=0

# --- data -------------------------------------------------------------------
# Free key: https://openalex.org/settings/api-key  (optional — only used by the
# enrichment probe; the pipeline runs on the vendored synthetic dataset alone.)
OPENALEX_API_KEY=
OPENALEX_MAILTO=
