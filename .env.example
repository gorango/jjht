# --- inference -------------------------------------------------------------
# Provider key for the model names in src/inference/runner.ts
# OpenAI, Anthropic or Gemini; DeepSeek goes through the OpenAI-compatible endpoint.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: point at any OpenAI-compatible endpoint (DeepSeek, OpenRouter, vLLM, Ollama).
OPENAI_BASE_URL=

# Model routing. Strong model plans, fast model does the bulk work.
EUREKA_MODEL=gpt-5.5
EUREKA_FAST_MODEL=gpt-5.4-mini

# Run the whole pipeline offline with a deterministic stand-in model.
MOCK=0

# --- data ------------------------------------------------------------------
# Free key: https://openalex.org/settings/api-key  (optional — only used by the
# enrichment probe; the pipeline runs on the vendored synthetic dataset alone.)
OPENALEX_API_KEY=
OPENALEX_MAILTO=
